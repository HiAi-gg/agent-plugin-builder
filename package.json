{
  "name": "agent-plugins-builder",
  "version": "0.0.6",
  "description": "Create, convert, and package portable Agent Plugins from existing agent setups, skills, and MCP servers",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "HiAI",
    "url": "https://github.com/HiAi-gg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HiAi-gg/agent-plugins-builder.git"
  },
  "homepage": "https://github.com/HiAi-gg/agent-plugins-builder#readme",
  "bugs": {
    "url": "https://github.com/HiAi-gg/agent-plugins-builder/issues"
  },
  "keywords": [
    "agent-plugins",
    "agent-skills",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "developer-tools",
    "cli",
    "plugin-builder",
    "plugin-migration",
    "typescript",
    "bun"
  ],
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "bunx --bun eslint ."
  },
  "devDependencies": {
    "@agent-plugins-builder/cli": "workspace:*",
    "@agent-plugins-builder/core": "workspace:*",
    "@agent-plugins-builder/generator": "workspace:*",
    "@agent-plugins-builder/sources": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.1.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "typescript": "^5.5.0"
  }
}
