{
  "name": "@agent-plugins-builder/cli",
  "version": "0.0.7",
  "description": "CLI for Agent Plugins Builder",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiAi-gg/agent-plugins-builder.git",
    "directory": "packages/cli"
  },
  "keywords": ["agent-plugins", "cli", "agent-plugins-builder"],
  "engines": {
    "bun": ">=1.0.0"
  },
  "bin": {
    "agent-plugins": "./bin/agent-plugins"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-plugins-builder/core": "workspace:*",
    "@agent-plugins-builder/generator": "workspace:*",
    "@agent-plugins-builder/sources": "workspace:*",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9"
  }
}
